---
import MainHead from "../../../components/MainHead.astro";
import NavHero from "../../../components/NavHero/index.jsx";
import readingTime from "reading-time";
import Footer from "../../../components/Footer";
import dateFormat from "dateformat";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BlogPostEntry from "../../../components/BlogPostEntry.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    const tags = new Set(posts.map((post) => post.data.tags ?? []).flat());
    return Array.from(tags).map((tag) => ({
        params: { tag },
        props: {
            tag,
            posts: posts.filter((post) => post.data.tags?.includes(tag)),
        },
    }));
}

interface Props {
    tag: string;
    posts: CollectionEntry<"blog">[];
}

const { tag, posts } = Astro.props;

const allPosts = posts
    .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
    .reverse();
---

<html lang="en">
    <head>
        <MainHead
            title={`Blog: ${tag} | Liz Ainslie`}
            description="Liz Ainslie: Freelance & Hobbyist Full Stack Developer"
        />
    </head>
    <body>
        <div class="flex flex-col min-h-screen">
            <NavHero>
                <div
                    class="py-32 flex flex-col items-center text-center topography"
                    style="fill: #1e2329;"
                >
                    <h1 class="font-display text-6xl font-light text-white">
                        Blog
                    </h1>
                    <p class="text-2xl mt-4 text-white">
                        My writing about {tag}
                    </p>
                </div>
            </NavHero>

            <div class="container mx-auto py-8 flex-grow">
                <div class="flex flex-col">
                    {allPosts.map((post) => <BlogPostEntry post={post} />)}
                </div>
            </div>

            <Footer />
        </div>
    </body>
</html>
